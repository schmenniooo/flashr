# Copy to .env and adjust for your machine. Vite reads it automatically.

# URL the dev server proxies /api/* to. With backend in docker compose this
# is http://localhost:8080. Override if you run the backend elsewhere.
BACKEND_URL=http://localhost:8080

# Optional: override the Vite dev server bind. Defaults to 127.0.0.1:5173.
# VITE_HOST=0.0.0.0
# VITE_PORT=5173

# Optional: only needed in production where the frontend lives on a different
# origin than the backend (e.g. flashr.io → api.flashr.io). In dev the proxy
# handles routing, so the frontend just calls relative /api paths.
# VITE_API_URL=https://api.flashr.io

# PostHog analytics — get the project token from eu.posthog.com
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
