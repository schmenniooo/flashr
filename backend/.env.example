# Copy to .env and fill in the values for your environment.
# The Go server reads these via os.Getenv — no library needed.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flashr?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub (announcements feed) ───────────────────────────────────────────────
GITHUB_TOKEN=

# ── Stripe (web billing) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173

# ── Ollama (AI card generation) ───────────────────────────────────────────────
# Leave empty to disable AI features locally. In production this points to the
# self-hosted Ollama instance on Railway.
OLLAMA_URL=http://localhost:11434

# ── File storage (Railway volume or S3-compatible) ────────────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# ── Push notifications (Web Push / VAPID) ─────────────────────────────────────
# Generated automatically by the notifications service on first boot if empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@flashr.io

# ── iOS / Apple (add when Apple Developer Account is ready) ───────────────────
# Not required for local development or web-only deployments.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=   # contents of the .p8 key file, single-line
